{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "skipLibCheck": true,
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "strict": true,
        "types": [
            "node",
            "vite/client"
        ],
        "resolveJsonModule": true
    },
    "include": [
        "src",
        "scripts",
        "tests",
        "*.ts"
    ]
}
